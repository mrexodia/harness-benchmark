# Fixed for every run in a study. Change only between studies.

# Model provider: a folder in local/providers/ or providers/ (see providers/README.md)
# that sets HC_MODEL, MODEL_HOSTS and SECRET_ENV. Set it in local/benchmark.env
# (gitignored), which overrides this file, or per run with --provider.
PROVIDER=
# Thinking level passed to the harness; leave empty to use the harness default.
HC_THINKING=

# Wall-clock limit per run, in minutes (open decision in plan.md; 60 is a placeholder).
WALL_CLOCK_MINUTES=60

# Images.
AGENT_IMAGE=hc-agent:latest
EVAL_IMAGE=hc-eval:latest
EGRESS_IMAGE=node:24.22.3-bookworm
