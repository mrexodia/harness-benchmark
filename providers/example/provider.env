# Template for a model provider. Copy this folder to local/providers/<name>/
# (gitignored) for a private backend, or to providers/<name>/ to commit it.
# Select it with PROVIDER=<name> in local/benchmark.env, or ./hc run --provider <name>.

# Model, as the harnesses name it.
HC_MODEL=anthropic/claude-sonnet-5-5
# Hosts the model endpoint lives on, added to the egress allowlist (comma-separated).
# Add :port for an endpoint not on 443, e.g. llm.example.lan:8080.
MODEL_HOSTS=api.anthropic.com
# Host env vars passed into the agent container by name (comma-separated).
SECRET_ENV=ANTHROPIC_API_KEY
